services:
  droidtv-remote:
    container_name: droidtv-remote
    image: vm75/droidtv-remote:latest
    restart: unless-stopped
    # Host networking lets the server reach TVs on the LAN.
    network_mode: host
    environment:
      SERVER_PORT: 7503
      DROIDTV_ADB_ENABLED: "false"
      DROIDTV_ADB_PATH: /usr/bin/adb
    volumes:
      - ./data:/app/data
